<resources>
    <style name="Theme.BillApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 现有 -->
        <item name="colorPrimary">#52B788</item>
        <item name="colorPrimaryVariant">#40916C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#52B788</item>
        <item name="colorSecondaryVariant">#40916C</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">#52B788</item>

        <!-- 🔥 新增：状态栏透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="MyTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="ShapeAppearanceOverlay.Button.RoundedLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Button.RoundedRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="DayOfWeekStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#999999</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <style name="MyBottomNavText">
        <item name="android:textSize">11dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- 首页（含 支出/收入 子页） -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="cn.yangwanhao.billapp.ui.home.HomeFragment"
        android:label="首页"
        tools:layout="@layout/fragment_home" />

    <!-- 🔥 新增：统计 -->
    <fragment
        android:id="@+id/statsFragment"
        android:name="cn.yangwanhao.billapp.ui.statistics.StatsFragment"
        android:label="统计"
        tools:layout="@layout/fragment_stats" />

    <!-- 🔥 新增：我的 -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="cn.yangwanhao.billapp.ui.profile.ProfileFragment"
        android:label="我的"
        tools:layout="@layout/fragment_profile" />

    <!-- 导入主页面 -->
    <fragment
        android:id="@+id/importMainFragment"
        android:name="cn.yangwanhao.billapp.ui.profile.imports.ImportMainFragment"
        android:label="文件导入"
        tools:layout="@layout/fragment_import_main" />

    <!-- 支出导入页面 -->
    <fragment
        android:id="@+id/importExpenseFragment"
        android:name="cn.yangwanhao.billapp.ui.profile.imports.ImportExpenseFragment"
        android:label="支出导入"
        tools:layout="@layout/fragment_import_expense" />

    <action
        android:id="@+id/action_home_to_importMain"
        app:destination="@id/importMainFragment" />

    <action
        android:id="@+id/action_importMain_to_importExpense"
        app:destination="@id/importExpenseFragment" />

    <fragment
        android:id="@+id/importIncomeFragment"
        android:name="cn.yangwanhao.billapp.ui.profile.imports.ImportIncomeFragment"
        android:label="收入导入"
        tools:layout="@layout/fragment_import_income" />

</navigation>
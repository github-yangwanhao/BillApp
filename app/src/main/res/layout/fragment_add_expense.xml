<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bottom_sheet_rounded_top"
    android:elevation="8dp">

    <!-- ========== 顶部标题 ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="记一笔"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- ========== 金额（hint=消费金额，默认显示0） ========== -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="消费金额"
        app:prefixText="¥ "
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:maxLength="10"
            android:text="0" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========== 日期 ========== -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="消费日期"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_calendar"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========== 分类 ========== -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="消费分类"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========== 支付方式 ========== -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="支付方式"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPayChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========== 备注（独立输入框，无灰色背景包裹） ========== -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="消费备注"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="3"
            android:textSize="16sp"
            android:text="请输入或选择备注"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========== 备注快捷标签（只有标签本身是灰色背景） ========== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llRemarkTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- ========== 底部按钮（加高到 80dp） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bottom_button_rounded"
        android:clipToOutline="true">

        <!-- 取消按钮（灰色背景） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="18sp"
            android:textColor="#666666"
            android:backgroundTint="#F5F5F5"
            app:cornerRadius="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Button.RoundedLeft" />

        <!-- 分割线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- 保存按钮（主色） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="保存"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/colorAccent"
            app:cornerRadius="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Button.RoundedRight" />
    </LinearLayout>

</LinearLayout>
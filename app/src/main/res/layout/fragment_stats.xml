<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <!-- ==================== 固定顶部 ==================== -->
    <LinearLayout
        android:id="@+id/fixedTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F9FC"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 时间切换器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_left"
                android:background="@drawable/bg_circle_white"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2026年09月"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/bg_circle_white"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 顶层 Tab -->
        <LinearLayout
            android:id="@+id/topTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/pub_segmented_bg"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="月度"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6366F1"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_tab_selected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="年度"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#868E96"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="汇总"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#868E96"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 下拉刷新 + 可滚动内容 ==================== -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/fixedTop"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ==================== 空状态（默认隐藏） ==================== -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="80dp"
                    android:paddingBottom="80dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_empty_bill"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="暂无数据"
                        android:textColor="#999999"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="换个时间范围试试"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ==================== 内容容器 ==================== -->
                <LinearLayout
                    android:id="@+id/contentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 收支双卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <!-- 收入卡片 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_white_rounded"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_dot_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="收入"
                                    android:textSize="12sp"
                                    android:textColor="#868E96" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvIncomeAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="¥0.00"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#2B8A3E"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvIncomeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="共 0 笔"
                                android:textSize="11sp"
                                android:textColor="#ADB5BD" />
                        </LinearLayout>

                        <!-- 支出卡片 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_white_rounded"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_dot_red" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="支出"
                                    android:textSize="12sp"
                                    android:textColor="#868E96" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvExpenseAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="¥0.00"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FA5252"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvExpenseCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="共 0 笔"
                                android:textSize="11sp"
                                android:textColor="#ADB5BD" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 结余卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_white_rounded"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="结余"
                                android:textSize="12sp"
                                android:textColor="#868E96" />

                            <TextView
                                android:id="@+id/tvBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="¥0.00"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#2B8A3E"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBalanceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_positive"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="—"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#2B8A3E" />
                    </LinearLayout>

                    <!-- ==================== 折线图卡片 ==================== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_white_rounded"
                        android:layout_marginBottom="16dp">

                        <!-- 标题 + 含大额开关 + 图例/提示 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvChartTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="每日趋势"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1C1C1E" />

                            <TextView
                                android:id="@+id/tvBigAmountToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:background="@drawable/bg_toggle_off"
                                android:text="含大额"
                                android:textSize="10sp"
                                android:textColor="#868E96"
                                android:clickable="true"
                                android:focusable="true" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:id="@+id/chartLegend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="14dp"
                                        android:layout_height="2dp"
                                        android:background="#2B8A3E" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="收入"
                                        android:textSize="11sp"
                                        android:textColor="#868E96" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="14dp"
                                        android:layout_height="2dp"
                                        android:background="#FA5252" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="支出"
                                        android:textSize="11sp"
                                        android:textColor="#868E96" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvChartNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠ 月度仅显示支出趋势"
                                android:textSize="10sp"
                                android:textColor="#ADB5BD"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- 折线图 -->
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="8dp" />

                        <!-- 信息栏 -->
                        <LinearLayout
                            android:id="@+id/chartInfoBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:background="#FFFFFF">

                            <TextView
                                android:id="@+id/tvInfoDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1C1C1E"
                                android:fontFamily="monospace" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvInfoIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2B8A3E"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvInfoExpense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#FA5252"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- 滑动提示 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingEnd="16dp"
                            android:paddingBottom="8dp"
                            android:text="左右滑动 · 点击查看金额"
                            android:textSize="10sp"
                            android:textColor="#CED4DA"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- 分类 Tab -->
                    <LinearLayout
                        android:id="@+id/catTabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/pub_segmented_bg"
                        android:padding="3dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tabCatExpense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="支出"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#6366F1"
                            android:gravity="center"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:background="@drawable/bg_tab_selected"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tabCatIncome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="收入"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#868E96"
                            android:gravity="center"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- 分类排行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_white_rounded"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="分类排行"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1C1C1E" />

                            <TextView
                                android:id="@+id/tvCategorySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="按支出金额"
                                android:textSize="11sp"
                                android:textColor="#ADB5BD" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCategoryRank"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- 支付方式排行（仅支出时显示） -->
                    <LinearLayout
                        android:id="@+id/channelRankCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_white_rounded"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="支付方式排行"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1C1C1E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="按支出金额"
                                android:textSize="11sp"
                                android:textColor="#ADB5BD" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvChannelRank"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                </LinearLayout>
                <!-- 内容容器 结束 -->

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>